{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["api/**/*.js", "netlify/edge-functions/*.js"],
  "project": ["src/**/*.{js,jsx,ts,tsx}"],
  "ignore": ["src/local/**", "src/modules/Quote/data/**", "src/shared/dtos/**"],
  "ignoreDependencies": ["@netlify/edge-functions"],
  "ignoreExportsUsedInFile": true,
  "vite": true,
  "vitest": true
}
